# Copy this file to `.env` for local development.
#
# User/org page:
#   ASTRO_SITE must be the site origin only, with no trailing slash.
#   ASTRO_SITE=https://coolmoon327.github.io
#   ASTRO_BASE=
#
ASTRO_SITE=https://coolmoon327.github.io
ASTRO_BASE=

# Optional override for the public encrypted home-directory envelope.
# The password and plaintext service addresses must never be placed here.
PUBLIC_HOME_REGISTRY_URL=https://raw.githubusercontent.com/coolmoon327/home-endpoint-registry/main/endpoint.enc.json
