# Dedicated public registry repository; it contains only the encrypted artifact.
REGISTRY_REMOTE_URL=git@github.com:coolmoon327/home-endpoint-registry.git
REGISTRY_BRANCH=main

# Override this only when the default Docker Hub route is unavailable.
NODE_IMAGE=node:24-alpine

PUBLISH_INTERVAL_SECONDS=600
IP_DISCOVERY_TIMEOUT_MS=5000
IP_DISCOVERY_MIN_AGREEMENT=2
PBKDF2_ITERATIONS=600000
HOME_HEARTBEAT_HOURS=6
HOME_REGISTRY_TTL_HOURS=24

# Optional: override the comma-separated HTTPS discovery providers.
# PUBLIC_IP_PROVIDERS=
