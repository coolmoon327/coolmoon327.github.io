---
import NewsIndex from '@components/news/NewsIndex.astro';
import { assertBilingualNewsPairs, listedNews, sortNews } from '@utils/news';
import { getCollection } from 'astro:content';

const allNews = await getCollection('news');
assertBilingualNewsPairs(allNews);
const entries = sortNews(listedNews(allNews, 'zh'));
---

<NewsIndex locale="zh" entries={entries} />
