---
import { site } from '@config/site';
import Base from '@layouts/Base.astro';
import { withBase } from '@utils/base';

interface Props {
  locale: 'en' | 'zh';
}

const { locale } = Astro.props;
const content = site.playground[locale];
const gamePath = (id: string) => withBase(`/pocket-play/games/${id}/`);
const embeddedGamePath = (id: string) => `${gamePath(id)}?embed=1`;
---

<Base title={content.title} description={content.intro}>
  <div class="playground page-container">
    <header class="page-hero">
      <p class="eyebrow">{content.eyebrow}</p>
      <h1>{content.title}</h1>
      <p>{content.intro}</p>
    </header>

    <aside class="demo-note" aria-labelledby="demo-boundary-heading">
      <span>{content.boundaryLabel}</span>
      <div>
        <p id="demo-boundary-heading">{content.boundary}</p>
        <p>{content.interfaceNote}</p>
        <p>{content.scoreNote}</p>
      </div>
    </aside>

    <section class="game-grid" aria-label={content.galleryLabel}>
      {
        content.games.map((game, index) => (
          <article class="game-card" id={`game-${game.id}`}>
            <header class="game-heading">
              <div>
                <p class="game-kind">{game.kind}</p>
                <h2>
                  {game.title}
                  <span lang={locale === 'en' ? 'zh-CN' : 'en'}>{game.nativeTitle}</span>
                </h2>
              </div>
              <dl>
                <div>
                  <dt>{content.sessionLabel}</dt>
                  <dd>{game.session}</dd>
                </div>
              </dl>
            </header>

            <p class="game-description">{game.description}</p>

            <iframe
              class="game-frame"
              src={embeddedGamePath(game.id)}
              title={`${game.title} — ${content.iframeTitleSuffix}`}
              loading={index === 0 ? 'eager' : 'lazy'}
              sandbox="allow-scripts"
              referrerpolicy="no-referrer"
              style={`height: ${game.height}px;`}
            />

            <div class="placement-note">
              <span>{content.placementLabel}</span>
              <p>{game.placement}</p>
            </div>

            <a class="open-game" href={gamePath(game.id)} target="_blank" rel="noopener noreferrer">
              {content.openAction} <span aria-hidden="true">↗</span>
            </a>
          </article>
        ))
      }
    </section>
  </div>
</Base>

<style>
  .playground {
    max-width: 1040px;
    min-height: calc(100vh - 57px);
    padding: clamp(3rem, 8vw, 6.5rem) 1.25rem 5rem;
  }

  .page-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.28fr);
    column-gap: 3rem;
    align-items: end;
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }

  .eyebrow,
  .demo-note > span,
  .game-kind,
  .game-heading dt,
  .placement-note > span {
    color: var(--global-theme-color);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .eyebrow {
    grid-column: 1 / -1;
    margin: 0 0 0.65rem;
  }

  .page-hero h1 {
    margin: 0;
    color: var(--global-text-color);
    font-size: clamp(3.1rem, 9vw, 5.8rem);
    letter-spacing: -0.06em;
    line-height: 0.92;
  }

  .page-hero > p:last-child {
    max-width: 640px;
    margin: 0;
    color: var(--global-text-color-light);
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .demo-note {
    display: grid;
    grid-template-columns: minmax(8rem, 0.3fr) minmax(0, 1fr);
    gap: 1.25rem;
    margin-bottom: 2.5rem;
    padding: 1.25rem 1.4rem;
    border: 1px solid color-mix(in srgb, var(--global-theme-color) 28%, transparent);
    border-radius: 1rem;
    background: color-mix(in srgb, var(--global-theme-color) 6%, var(--global-card-bg-color));
  }

  .demo-note p {
    margin: 0;
    color: var(--global-text-color-light);
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .demo-note p + p {
    margin-top: 0.55rem;
  }

  .game-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.1rem;
    align-items: start;
  }

  .game-card {
    min-width: 0;
    padding: 1.25rem;
    border: 1px solid var(--global-divider-color);
    border-radius: 1.25rem;
    background: var(--global-card-bg-color);
  }

  .game-heading {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    justify-content: space-between;
  }

  .game-kind {
    margin: 0 0 0.45rem;
  }

  .game-heading h2 {
    margin: 0;
    color: var(--global-text-color);
    font-size: clamp(1.35rem, 3vw, 1.8rem);
    letter-spacing: -0.025em;
    line-height: 1.1;
  }

  .game-heading h2 span {
    display: block;
    margin-top: 0.35rem;
    color: var(--global-text-color-light);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  .game-heading dl,
  .game-heading dd {
    margin: 0;
  }

  .game-heading dl {
    flex: 0 0 auto;
    text-align: right;
  }

  .game-heading dd {
    margin-top: 0.3rem;
    color: var(--global-text-color-light);
    font-size: 0.78rem;
  }

  .game-description {
    min-height: 4.8rem;
    margin: 1rem 0;
    color: var(--global-text-color-light);
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .game-frame {
    display: block;
    width: min(100%, 420px);
    margin: 0 auto;
    border: 0;
    border-radius: 1.1rem;
    background: transparent;
  }

  .placement-note {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--global-divider-color);
  }

  .placement-note p {
    margin: 0.45rem 0 0;
    color: var(--global-text-color-light);
    font-size: 0.86rem;
    line-height: 1.6;
  }

  .open-game {
    display: inline-flex;
    gap: 0.35rem;
    align-items: center;
    margin-top: 1rem;
    color: var(--global-theme-color);
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
  }

  .open-game:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @media (max-width: 900px) {
    .game-grid {
      grid-template-columns: 1fr;
    }

    .game-description {
      min-height: 0;
    }
  }

  @media (max-width: 760px) {
    .page-hero,
    .demo-note {
      grid-template-columns: 1fr;
    }

    .page-hero {
      gap: 1.5rem;
    }

    .demo-note {
      gap: 0.55rem;
    }
  }

  @media (max-width: 480px) {
    .playground {
      padding-right: 0.85rem;
      padding-left: 0.85rem;
    }

    .game-card {
      padding: 0.85rem;
    }

    .game-heading {
      display: grid;
    }

    .game-heading dl {
      text-align: left;
    }
  }
</style>
