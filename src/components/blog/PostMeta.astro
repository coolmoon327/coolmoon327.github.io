---
import type { PostLocale } from '@utils/posts';

interface Props {
  date: Date | string;
  tags?: string[];
  categories?: string[];
  readingTime?: number;
  locale?: PostLocale;
}

const { date, tags = [], categories = [], readingTime, locale = 'en' } = Astro.props;
const languageTag = locale === 'zh' ? 'zh-CN' : 'en-US';
const published = date instanceof Date ? date : new Date(date);
const formattedDate = published.toLocaleDateString(languageTag, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const readingLabel = readingTime
  ? new Intl.NumberFormat(languageTag, {
      style: 'unit',
      unit: 'minute',
      unitDisplay: 'short',
    }).format(readingTime)
  : undefined;
---

<div
  class="post-meta mt-1 flex flex-wrap items-center gap-2 text-xs"
  style="color: var(--global-text-color-light);"
>
  <time datetime={published.toISOString()}>{formattedDate}</time>

  {
    readingLabel && (
      <>
        <>
          <span aria-hidden="true">·</span>
          <span>{readingLabel}</span>
        </>
      </>
    )
  }

  {
    categories.length > 0 && (
      <>
        <span aria-hidden="true">·</span>
        <div class="flex flex-wrap gap-1">
          {categories.map((category) => (
            <span
              class="badge-abbr text-xs"
              style="background-color: var(--global-text-color-light); color: var(--global-hover-text-color);"
            >
              {category}
            </span>
          ))}
        </div>
      </>
    )
  }

  {
    tags.length > 0 && (
      <>
        <span aria-hidden="true">·</span>
        <div class="flex flex-wrap gap-1">
          {tags.map((tag) => (
            <span
              class="badge-abbr text-xs"
              style="background-color: var(--global-theme-color); color: var(--global-hover-text-color);"
            >
              {tag}
            </span>
          ))}
        </div>
      </>
    )
  }
</div>
