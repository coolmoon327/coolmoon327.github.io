---
import { site } from '@config/site';
import Base from '@layouts/Base.astro';
import type { PostLocale } from '@utils/posts';
import type { CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';

import PostCard from './PostCard.astro';

interface Props {
  locale: PostLocale;
  posts: CollectionEntry<'posts'>[];
}

const { locale, posts } = Astro.props;
const page = site.pages.localized[locale].blog;
const protectedRoute = locale === 'zh' ? '/zh/blog/protected/' : '/blog/protected/';
---

<Base title={page.title} description={page.intro}>
  <div class="blog-index page-container">
    <header>
      <div>
        <p class="eyebrow">{page.eyebrow}</p>
        <h1>{page.title}</h1>
      </div>
      <div class="intro-column">
        <p class="intro">{page.intro}</p>
        <div class="header-links">
          <a class="protected-link" href={`${site.base}${protectedRoute}`}>{page.protectedLabel}</a>
          <a class="rss-link" href={`${site.base}/rss.xml`} aria-label={page.rssLabel}>
            <Icon name="fa-solid:rss" aria-hidden="true" />
            <span>{page.rssLabel}</span>
          </a>
        </div>
      </div>
    </header>

    {
      posts.length > 0 ? (
        <ol class="post-list" aria-label={page.title}>
          {posts.map((post) => (
            <li>
              <PostCard post={post} locale={locale} />
            </li>
          ))}
        </ol>
      ) : (
        <section class="empty-state" aria-labelledby="blog-empty-heading">
          <span class="status">{page.status}</span>
          <h2 id="blog-empty-heading">{page.statusTitle}</h2>
          <p>{page.statusBody}</p>
        </section>
      )
    }
  </div>
</Base>

<style>
  .blog-index {
    max-width: 980px;
    min-height: calc(100vh - 57px);
    padding: clamp(3rem, 8vw, 6.5rem) 1.25rem 5rem;
  }

  header {
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
    gap: 3rem;
    align-items: end;
    margin-bottom: clamp(2.5rem, 7vw, 4.5rem);
  }

  .eyebrow,
  .status {
    color: var(--global-theme-color);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 12ch;
    margin: 0.75rem 0 0;
    font-family: var(--font-condensed);
    font-size: clamp(2.75rem, 8vw, 5.5rem);
    line-height: 0.9;
  }

  .intro-column {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .intro {
    max-width: 42rem;
    margin: 0;
    color: var(--global-text-color-light);
    font-size: clamp(1rem, 2.2vw, 1.25rem);
    line-height: 1.65;
  }

  .header-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem;
  }

  .rss-link,
  .protected-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--global-theme-color);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-decoration: none;
  }

  .rss-link:hover,
  .protected-link:hover {
    color: var(--global-hover-color);
  }

  .protected-link {
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--global-divider-color);
    border-radius: 999px;
  }

  .post-list {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--global-divider-color);
  }

  .post-list > li {
    padding: clamp(1.5rem, 4vw, 2.25rem) 0;
  }

  .empty-state {
    max-width: 44rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 1px solid var(--global-divider-color);
    border-radius: 0.75rem;
    background: var(--global-card-bg-color);
  }

  .empty-state h2 {
    margin: 0.65rem 0 0.75rem;
    font-family: var(--font-condensed);
    font-size: clamp(1.5rem, 4vw, 2rem);
  }

  .empty-state p {
    margin: 0;
    color: var(--global-text-color-light);
    line-height: 1.7;
  }

  @media (max-width: 720px) {
    header {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    h1 {
      max-width: none;
    }
  }
</style>
