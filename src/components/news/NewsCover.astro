---
import { withBase } from '@utils/base';
import type { NewsEntry } from '@utils/news';

interface Props {
  entry: NewsEntry;
  compact?: boolean;
}

const { entry, compact = false } = Astro.props;
const {
  coverImage,
  coverImageAlt,
  coverImageCredit,
  coverKicker,
  coverPoints,
  coverTitle,
  coverTone,
} = entry.data;
---

<div
  class:list={[
    'news-cover',
    { 'news-cover--image': Boolean(coverImage), 'news-cover--compact': compact },
  ]}
  data-tone={coverTone}
>
  {
    coverImage ? (
      <>
        <img src={withBase(coverImage)} alt={coverImageAlt ?? ''} loading="lazy" />
        {coverImageCredit && <span class="news-cover__credit">{coverImageCredit}</span>}
      </>
    ) : (
      <div class="news-cover__poster" role="img" aria-label={coverTitle}>
        <span class="news-cover__orbit" aria-hidden="true" />
        <p class="news-cover__kicker">{coverKicker}</p>
        <p class="news-cover__title">{coverTitle}</p>
        <ul aria-hidden="true">
          {coverPoints.map((point) => (
            <li>{point}</li>
          ))}
        </ul>
      </div>
    )
  }
</div>

<style>
  .news-cover {
    position: relative;
    width: 100%;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border-bottom: 1px solid color-mix(in srgb, var(--global-divider-color) 80%, transparent);
    background: var(--news-cover-bg);
    color: var(--news-cover-ink);
  }

  .news-cover[data-tone='ocean'] {
    --news-cover-bg: #0b3650;
    --news-cover-accent: #5ee5d5;
    --news-cover-ink: #f5fffd;
  }

  .news-cover[data-tone='violet'] {
    --news-cover-bg: #2d1b53;
    --news-cover-accent: #d1b7ff;
    --news-cover-ink: #fffaff;
  }

  .news-cover[data-tone='amber'] {
    --news-cover-bg: #f3aa3c;
    --news-cover-accent: #3a2510;
    --news-cover-ink: #25160a;
  }

  .news-cover[data-tone='mint'] {
    --news-cover-bg: #c6f0dc;
    --news-cover-accent: #11614c;
    --news-cover-ink: #12392f;
  }

  .news-cover[data-tone='rose'] {
    --news-cover-bg: #8a1f43;
    --news-cover-accent: #ffe7b8;
    --news-cover-ink: #fffafb;
  }

  .news-cover[data-tone='slate'] {
    --news-cover-bg: #202834;
    --news-cover-accent: #9dd5ff;
    --news-cover-ink: #f5f8fc;
  }

  .news-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .news-cover--compact.news-cover--image img {
    object-fit: contain;
  }

  .news-cover__credit {
    position: absolute;
    right: 0.55rem;
    bottom: 0.5rem;
    max-width: calc(100% - 1.1rem);
    padding: 0.2rem 0.38rem;
    border-radius: 0.25rem;
    background: rgb(0 0 0 / 70%);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 0.55rem;
    line-height: 1.3;
  }

  .news-cover__poster {
    position: relative;
    display: flex;
    height: 100%;
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(1rem, 7%, 1.55rem);
    isolation: isolate;
  }

  .news-cover__poster::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    background-image:
      linear-gradient(rgb(255 255 255 / 8%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 8%) 1px, transparent 1px);
    background-size: 2.25rem 2.25rem;
    content: '';
    mask-image: linear-gradient(to bottom, #000, transparent 70%);
  }

  .news-cover__orbit {
    position: absolute;
    z-index: -1;
    top: 9%;
    right: -18%;
    width: 82%;
    aspect-ratio: 1;
    border: 1px solid color-mix(in srgb, var(--news-cover-accent) 75%, transparent);
    border-radius: 50%;
    box-shadow:
      0 0 0 1.25rem color-mix(in srgb, var(--news-cover-accent) 9%, transparent),
      0 0 0 3.2rem color-mix(in srgb, var(--news-cover-accent) 5%, transparent);
  }

  .news-cover__kicker {
    margin: 0 0 0.65rem;
    color: var(--news-cover-accent);
    font-family: var(--font-mono);
    font-size: clamp(0.58rem, 1.1vw, 0.72rem);
    font-weight: 700;
    letter-spacing: 0.09em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .news-cover__title {
    margin: 0;
    font-family: var(--font-condensed);
    font-size: clamp(1.45rem, 3vw, 2.3rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 0.98;
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  .news-cover ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .news-cover li {
    padding: 0.2rem 0.4rem;
    border: 1px solid color-mix(in srgb, var(--news-cover-accent) 45%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--news-cover-bg) 78%, transparent);
    font-family: var(--font-mono);
    font-size: 0.56rem;
    line-height: 1.25;
  }

  .news-cover--compact .news-cover__title {
    font-size: clamp(1.25rem, 2.7vw, 2rem);
  }

  .news-cover--compact:not(.news-cover--image) {
    min-height: 15rem;
    aspect-ratio: auto;
  }

  .news-cover--compact:not(.news-cover--image) .news-cover__poster {
    min-height: inherit;
    height: auto;
  }

  @media (prefers-reduced-motion: no-preference) {
    .news-cover__orbit {
      transition: transform 240ms ease;
    }

    :global(.news-card-link:hover) .news-cover__orbit {
      transform: translate(-0.25rem, 0.25rem) scale(1.04);
    }
  }
</style>
