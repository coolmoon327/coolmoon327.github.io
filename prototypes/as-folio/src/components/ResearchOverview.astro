---
import { site } from '@config/site';
import Base from '@layouts/Base.astro';
import { withBase } from '@utils/base';

interface Props {
  locale: 'en' | 'zh';
}

const { locale } = Astro.props;
const content = site.research[locale];

const isExternal = (href: string) => /^https?:\/\//.test(href);
---

<Base title={content.title} description={content.intro}>
  <div class="research-page page-container">
    <header class="page-hero">
      <p class="eyebrow">{content.eyebrow}</p>
      <h1>{content.title}</h1>
      <p>{content.intro}</p>
    </header>

    <section class="doctoral-card" aria-labelledby="doctoral-heading">
      <div class="doctoral-copy">
        <p class="section-label">{content.currentLabel}</p>
        <h2 id="doctoral-heading">{content.currentTitle}</h2>
        <p>{content.currentBody}</p>
      </div>

      <dl class="program-facts">
        <div>
          <dt>{content.programLabel}</dt>
          <dd>{content.program}</dd>
        </div>
        <div>
          <dt>{content.dissertationLabel}</dt>
          <dd>{content.dissertation}</dd>
        </div>
        <div>
          <dt>{content.studyModeLabel}</dt>
          <dd>{content.studyMode}</dd>
        </div>
      </dl>

      <div class="advisor-block">
        <h3>{content.advisorsLabel}</h3>
        <ul>
          {
            content.advisors.map((advisor) => (
              <li>
                <span>{advisor.role}</span>
                <strong>{advisor.name}</strong>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <aside class="status-note" aria-labelledby="public-status-heading">
      <span>{content.publicStatusLabel}</span>
      <p id="public-status-heading">{content.publicStatus}</p>
    </aside>

    <section class="trajectory" aria-labelledby="trajectory-heading">
      <div class="section-heading">
        <h2 id="trajectory-heading">{content.trajectoryLabel}</h2>
        <p>{content.trajectoryIntro}</p>
      </div>

      <ol>
        {
          content.stages.map((stage) => (
            <li>
              <span class="marker">{stage.marker}</span>
              <div>
                <h3>{stage.title}</h3>
                <p>{stage.body}</p>
                {stage.links.length > 0 && (
                  <div class="stage-links">
                    {stage.links.map((link) => (
                      <a
                        href={isExternal(link.href) ? link.href : withBase(link.href)}
                        target={isExternal(link.href) ? '_blank' : undefined}
                        rel={isExternal(link.href) ? 'noopener noreferrer' : undefined}
                      >
                        {link.label} <span aria-hidden="true">↗</span>
                      </a>
                    ))}
                  </div>
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="education" aria-labelledby="education-heading">
      <h2 id="education-heading">{content.educationLabel}</h2>
      <p>{content.education}</p>
    </section>
  </div>
</Base>

<style>
  .research-page {
    max-width: 1040px;
    min-height: calc(100vh - 57px);
    padding: clamp(3rem, 8vw, 6.5rem) 1.25rem 5rem;
  }

  .page-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.28fr);
    column-gap: 3rem;
    align-items: end;
    margin-bottom: clamp(3rem, 7vw, 5rem);
  }

  .eyebrow,
  .section-label,
  .program-facts dt,
  .advisor-block li span,
  .status-note > span,
  .marker {
    color: var(--global-theme-color);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .eyebrow {
    grid-column: 1 / -1;
    margin: 0 0 0.65rem;
  }

  .page-hero h1 {
    margin: 0;
    color: var(--global-text-color);
    font-size: clamp(3.2rem, 9vw, 6rem);
    letter-spacing: -0.06em;
    line-height: 0.92;
  }

  .page-hero > p:last-child {
    max-width: 630px;
    margin: 0;
    color: var(--global-text-color-light);
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .doctoral-card {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: 2.5rem;
    padding: clamp(1.5rem, 5vw, 3rem);
    border: 1px solid var(--global-divider-color);
    border-radius: 1.25rem;
    background: var(--global-card-bg-color);
  }

  .section-label {
    margin: 0 0 0.75rem;
  }

  .doctoral-copy h2,
  .section-heading h2,
  .education h2 {
    margin: 0;
    color: var(--global-text-color);
    font-size: clamp(1.6rem, 4vw, 2.5rem);
    letter-spacing: -0.04em;
    line-height: 1.15;
  }

  .doctoral-copy > p:last-child,
  .section-heading p,
  .education p {
    color: var(--global-text-color-light);
    line-height: 1.75;
  }

  .program-facts {
    display: grid;
    gap: 1rem;
    margin: 0;
  }

  .program-facts div {
    padding-top: 1rem;
    border-top: 1px solid var(--global-divider-color);
  }

  .program-facts dt {
    margin-bottom: 0.4rem;
  }

  .program-facts dd {
    margin: 0;
    color: var(--global-text-color);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .advisor-block {
    grid-column: 1 / -1;
    padding-top: 1.5rem;
    border-top: 1px solid var(--global-divider-color);
  }

  .advisor-block h3 {
    margin: 0 0 1rem;
    color: var(--global-text-color);
    font-size: 0.9rem;
  }

  .advisor-block ul {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .advisor-block li {
    display: grid;
    gap: 0.35rem;
    padding: 1rem;
    border-radius: 0.8rem;
    background: var(--global-bg-color);
  }

  .advisor-block li strong {
    color: var(--global-text-color);
    font-size: 0.9rem;
  }

  .status-note {
    display: grid;
    grid-template-columns: 10rem 1fr;
    gap: 1.25rem;
    margin: 1rem 0 0;
    padding: 1.25rem 1.5rem;
    border-left: 3px solid var(--global-theme-color);
    background: color-mix(in srgb, var(--global-theme-color) 7%, var(--global-bg-color));
  }

  .status-note p {
    margin: 0;
    color: var(--global-text-color-light);
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .trajectory {
    padding: 5rem 0;
  }

  .section-heading {
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
    gap: 2.5rem;
    margin-bottom: 2rem;
  }

  .section-heading p {
    max-width: 620px;
    margin: 0.25rem 0 0;
  }

  .trajectory ol {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--global-divider-color);
    list-style: none;
  }

  .trajectory li {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 1.5rem;
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--global-divider-color);
  }

  .trajectory h3 {
    margin: 0;
    color: var(--global-text-color);
    font-size: 1.2rem;
  }

  .trajectory li p {
    max-width: 760px;
    margin: 0.6rem 0 0;
    color: var(--global-text-color-light);
    line-height: 1.7;
  }

  .stage-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 1rem;
  }

  .stage-links a {
    color: var(--global-theme-color);
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
  }

  .education {
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
    gap: 2.5rem;
    padding-top: 4rem;
    border-top: 1px solid var(--global-divider-color);
  }

  .education p {
    margin: 0.25rem 0 0;
  }

  @media (max-width: 760px) {
    .page-hero,
    .doctoral-card,
    .section-heading,
    .education {
      grid-template-columns: 1fr;
    }

    .page-hero {
      gap: 1.5rem;
    }

    .advisor-block {
      grid-column: auto;
    }

    .advisor-block ul {
      grid-template-columns: 1fr;
    }

    .status-note {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }

    .trajectory li {
      grid-template-columns: 4.5rem 1fr;
      gap: 1rem;
    }
  }
</style>
